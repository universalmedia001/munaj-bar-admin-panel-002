{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "supabase/functions",
    "dist",
    "src/components/admin",
    "src/components/BestSellingProductsTable.tsx",
    "src/components/CashierSalesReportView.tsx",
    "src/components/CloseShiftModal.tsx",
    "src/components/ConfigGuideModal.tsx",
    "src/components/Header.tsx",
    "src/components/LoginView.tsx",
    "src/components/LogoutConfirmationModal.tsx",
    "src/components/OpenShiftModal.tsx",
    "src/components/PosView.tsx",
    "src/components/ProfileView.tsx",
    "src/components/ReceiptModal.tsx",
    "src/components/ReceiptsLookupView.tsx",
    "src/components/SalesHistoryView.tsx",
    "src/components/ShiftHistoryView.tsx",
    "src/components/ShiftSignOutModal.tsx",
    "src/components/WorkerBroadcastToast.tsx",
    "src/components/WorkerNotificationsModal.tsx",
    "src/context/CartContext.tsx",
    "src/context/NotificationContext.tsx",
    "src/context/ShiftContext.tsx",
    "src/context/WorkerBrandingContext.tsx",
    "src/data/seedData.ts",
    "src/services/authService.ts",
    "src/services/notificationService.ts",
    "src/services/periodService.ts",
    "src/services/productService.ts",
    "src/services/receiptService.ts",
    "src/services/saleService.ts",
    "src/services/shiftService.ts",
    "src/types/database.types.ts",
    "src/utils/pdfGenerator.ts"
  ]
}
